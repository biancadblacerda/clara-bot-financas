# Copie este arquivo para ".env" e preencha. Nunca suba o .env para o GitHub.
TELEGRAM_TOKEN=cole_aqui_o_token_do_BotFather
GEMINI_API_KEY=cole_aqui_a_chave_do_Google_AI_Studio

# Modelo principal e um de reserva (usado quando o principal falha)
MODELO=gemini-3.5-flash-lite
MODELO_RESERVA=gemini-3.1-flash-lite

# Banco de dados. Sem esta linha, usa o arquivo local gastos.db (SQLite).
# Na nuvem, cole aqui o endereço do PostgreSQL: postgresql://usuario:senha@host/banco
# DATABASE_URL=

# Valores a partir deste pedem confirmação antes de salvar
LIMITE_CONFIRMACAO=500

# Só na nuvem: senha aleatória que o Telegram envia em cada chamada do webhook
# WEBHOOK_SECRET=
